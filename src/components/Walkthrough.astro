---
import type { Lang } from '../lib/i18n';
import '@fontsource/barlow-condensed/500.css';
import '@fontsource/barlow-condensed/600.css';
import '@fontsource/barlow-condensed/700.css';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
---

<div id="wt" class="wt" data-state="menu" data-lang={lang}>
  <!-- ESCENA 1 · Menú principal — Mirror's Edge (dark) -->
  <section class="screen screen-menu" data-screen="menu" aria-label="Menú principal">
    <div class="menu-shell">
      <header class="me-head">
        <span class="me-brand">Portfolio</span>
        <span class="me-head-line" aria-hidden="true"></span>
        <span class="me-head-mark" aria-hidden="true"></span>
      </header>

      <div class="title-block">
        <span class="me-slash" aria-hidden="true"></span>
        <h1 class="title">Lucas Pinto</h1>
        <p class="role" data-i18n="role">QA Engineer</p>
      </div>

      <div class="panel">
        <div class="opt-row">
          <span class="opt-label" data-i18n="language">Idioma</span>
          <div class="seg" role="group" data-i18n-aria="language">
            <button type="button" class="seg-btn" data-lang-opt="es" aria-pressed="true">ES</button>
            <button type="button" class="seg-btn" data-lang-opt="en" aria-pressed="false">EN</button>
          </div>
        </div>

        <div class="opt-row">
          <span class="opt-label" data-i18n="sound">Sonido</span>
          <button type="button" class="sound-toggle" id="wt-sound" aria-pressed="true">
            <svg class="icon-on" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M11 5 6 9H3v6h3l5 4z"></path>
              <path d="M15.5 8.5a5 5 0 0 1 0 7"></path>
              <path d="M18.5 5.5a9 9 0 0 1 0 13"></path>
            </svg>
            <svg class="icon-off" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M11 5 6 9H3v6h3l5 4z"></path>
              <path d="m16 9 5 6"></path>
              <path d="m21 9-5 6"></path>
            </svg>
            <span id="wt-sound-label">Encendido</span>
          </button>
        </div>

        <button type="button" class="start" id="wt-start" disabled>
          <span data-i18n="start">Comenzar</span>
          <svg class="start-arrow" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M4 12h15"></path>
            <path d="m13 6 6 6-6 6"></path>
          </svg>
        </button>

        <p class="status" id="wt-loading" role="status" data-i18n="loading">Cargando introducción…</p>
      </div>

      <a class="classic-link" id="wt-classic" href="#work">
        <span data-i18n="classic">Ver proyectos sin 3D</span>
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M12 4v15"></path>
          <path d="m6 13 6 6 6-6"></path>
        </svg>
      </a>
    </div>
  </section>

  <!-- ESCENA 2 · Cinemática (placeholder hasta la Fase 3) -->
  <section class="screen screen-cutscene" data-screen="cutscene" aria-label="Cinemática" hidden>
    <div class="placeholder" data-i18n="cutsceneSoon">Cinemática — próximamente</div>
    <div class="subs" id="wt-subs" aria-live="polite"></div>
    <button type="button" class="skip" id="wt-skip" data-i18n="skip">Saltar ▸</button>
  </section>

  <!-- ESCENA 3 · Primera persona (placeholder hasta la Fase 4) -->
  <section class="screen screen-fp" data-screen="fp" aria-label="Primera persona" hidden>
    <div class="placeholder" data-i18n="fpSoon">Primera persona — próximamente</div>
    <button type="button" class="ghost-menu" data-goto-menu data-i18n="backToMenu">◀ Volver al menú</button>
  </section>

  <!-- ESCENA 4 · Panel AR (placeholder hasta la Fase 5) -->
  <section class="screen screen-panel" data-screen="panel" aria-label="Panel AR" hidden>
    <div class="placeholder" data-i18n="panelSoon">Panel AR — próximamente</div>
    <button type="button" class="ghost-menu" data-goto-menu data-i18n="backToMenu">◀ Volver al menú</button>
  </section>
</div>

<button type="button" class="wt-restore" id="wt-restore" data-i18n="backToMenu" hidden>
  ◀ Volver al menú
</button>

<style>
  .wt {
    position: fixed;
    inset: 0;
    z-index: 60;
    color-scheme: dark;
    --me-red: #dd2c24;
    --me-red-hot: #f0362e;
    --me-line: rgba(255, 255, 255, 0.12);
    --me-edge: #3a4148;
    --wt-display: 'Barlow Condensed', 'Segoe UI', system-ui, sans-serif;
    font-family: var(--wt-display);
    color: #e7eaee;
    background:
      radial-gradient(150% 110% at 78% -20%, #1b2127 0%, #12161b 48%, #0b0e12 100%);
  }
  /* One authored motion moment: a slow light sweep, like sun off glass. */
  .wt::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    background: linear-gradient(
      100deg,
      transparent 35%,
      rgba(255, 255, 255, 0.045) 50%,
      transparent 65%
    );
    transform: translateX(-40%);
    animation: me-sweep 14s ease-in-out infinite alternate;
  }
  @keyframes me-sweep {
    to {
      transform: translateX(40%);
    }
  }
  .wt[data-state='classic'] {
    display: none;
  }

  .screen {
    position: absolute;
    inset: 0;
    z-index: 1;
    display: none;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 1.25rem;
    padding: 1.5rem;
    text-align: center;
  }
  .screen:not([hidden]) {
    display: flex;
  }

  .wt :where(button, a):focus-visible {
    outline: 2px solid #ff5a4d;
    outline-offset: 3px;
  }

  /* · Menú — Mirror's Edge (dark) */
  .screen-menu {
    text-align: left;
    /* Short windows / high zoom: never clip the header or the link. */
    overflow-y: auto;
    justify-content: safe center;
  }
  .menu-shell {
    position: relative;
    width: min(100%, 38rem);
    display: flex;
    flex-direction: column;
    gap: 2.1rem;
  }
  .me-head {
    display: flex;
    align-items: center;
    gap: 1rem;
  }
  .me-brand {
    font-weight: 600;
    font-size: 0.78rem;
    letter-spacing: 0.42em;
    text-transform: uppercase;
    color: #8b959e;
  }
  .me-head-line {
    flex: 1;
    height: 1px;
    background: var(--me-line);
  }
  .me-head-mark {
    width: 10px;
    height: 10px;
    background: var(--me-red);
    flex: none;
  }

  .title-block {
    position: relative;
  }
  .me-slash {
    position: absolute;
    left: -4%;
    bottom: 2.9rem;
    width: 72%;
    height: 14px;
    background: linear-gradient(90deg, var(--me-red) 60%, rgba(221, 44, 36, 0));
    transform: skewX(-24deg);
    opacity: 0.9;
  }
  .title {
    position: relative;
    font-weight: 700;
    font-size: clamp(3rem, 11vw, 6rem);
    line-height: 0.92;
    letter-spacing: -0.02em;
    text-transform: uppercase;
    margin: 0;
    color: #f2f4f6;
  }
  .role {
    position: relative;
    margin: 0.7rem 0 0;
    font-weight: 600;
    font-size: 1.25rem;
    letter-spacing: 0.34em;
    text-transform: uppercase;
    color: #aab4be;
  }

  .panel {
    position: relative;
    background: rgba(255, 255, 255, 0.035);
    border: 1px solid var(--me-line);
    backdrop-filter: blur(6px);
    padding: 0.35rem 1.4rem 1.4rem;
  }
  .panel::before {
    content: '';
    position: absolute;
    top: -1px;
    left: -1px;
    width: 56px;
    height: 3px;
    background: var(--me-red);
  }
  .opt-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 1.05rem 0;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  }
  .opt-label {
    font-weight: 600;
    font-size: 0.95rem;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: #8b959e;
  }
  .seg {
    display: inline-flex;
    border: 1px solid var(--me-edge);
    border-radius: 2px;
    overflow: hidden;
    background: rgba(0, 0, 0, 0.25);
  }
  .seg-btn {
    appearance: none;
    border: 0;
    background: transparent;
    color: #dfe3e7;
    font-family: inherit;
    font-weight: 600;
    font-size: 0.95rem;
    letter-spacing: 0.1em;
    padding: 0.5rem 1.05rem;
    cursor: pointer;
    transition:
      background 0.15s ease,
      color 0.15s ease;
  }
  .seg-btn + .seg-btn {
    border-left: 1px solid var(--me-edge);
  }
  .seg-btn:hover {
    background: rgba(255, 255, 255, 0.07);
  }
  .seg-btn[aria-pressed='true'] {
    background: var(--me-red);
    color: #fff;
  }

  .sound-toggle {
    appearance: none;
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    border: 1px solid var(--me-edge);
    border-radius: 2px;
    background: rgba(0, 0, 0, 0.25);
    color: #dfe3e7;
    font-family: inherit;
    font-weight: 600;
    font-size: 0.95rem;
    letter-spacing: 0.1em;
    padding: 0.5rem 1.05rem;
    cursor: pointer;
    transition:
      background 0.15s ease,
      color 0.15s ease;
  }
  .sound-toggle:hover {
    background: rgba(255, 255, 255, 0.07);
  }
  .sound-toggle[aria-pressed='false'] {
    color: #8b959e;
  }
  .sound-toggle .icon-off {
    display: none;
  }
  .sound-toggle[aria-pressed='false'] .icon-on {
    display: none;
  }
  .sound-toggle[aria-pressed='false'] .icon-off {
    display: block;
  }

  .start {
    appearance: none;
    border: 0;
    width: 100%;
    margin-top: 1.35rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 1rem 1.4rem;
    font-family: inherit;
    font-weight: 700;
    font-size: 1.35rem;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: #fff;
    background: var(--me-red);
    cursor: pointer;
    clip-path: polygon(
      0 0,
      100% 0,
      100% calc(100% - 16px),
      calc(100% - 16px) 100%,
      0 100%
    );
    transition: background 0.15s ease;
  }
  .start-arrow {
    flex: none;
    transition: transform 0.15s ease;
  }
  .start:hover:not(:disabled) {
    background: var(--me-red-hot);
  }
  .start:hover:not(:disabled) .start-arrow {
    transform: translateX(6px);
  }
  .start:disabled {
    background: #1b2026;
    color: #6d7680;
    cursor: wait;
    box-shadow: inset 0 0 0 1px var(--me-edge);
  }

  .status {
    margin: 0.95rem 0 0;
    display: flex;
    align-items: center;
    gap: 0.55rem;
    font-weight: 600;
    font-size: 0.8rem;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: #8b959e;
    min-height: 1.2em;
  }
  .status::before {
    content: '';
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--me-red);
    animation: me-pulse 1.4s ease-in-out infinite;
  }
  .status[data-done] {
    visibility: hidden;
  }
  @keyframes me-pulse {
    50% {
      opacity: 0.25;
    }
  }

  .classic-link {
    align-self: flex-start;
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    color: #dfe3e7;
    font-weight: 600;
    font-size: 0.95rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    text-decoration: none;
  }
  .classic-link:hover {
    color: #fff;
    text-decoration: none;
  }
  .classic-link svg {
    transition: transform 0.15s ease;
  }
  .classic-link:hover svg {
    transform: translateY(3px);
  }
  @media (max-width: 480px) {
    .menu-shell {
      gap: 1.5rem;
    }
    .start {
      font-size: 1.15rem;
      letter-spacing: 0.16em;
    }
  }

  /* · Placeholders de escenas */
  .screen-cutscene {
    background: #000;
  }
  .screen-fp,
  .screen-panel {
    background: #05070d;
  }
  .placeholder {
    font-size: clamp(1.1rem, 3vw, 1.5rem);
    color: #8b959e;
    letter-spacing: 0.1em;
  }
  .skip {
    position: absolute;
    top: 1.25rem;
    right: 1.25rem;
    appearance: none;
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(255, 255, 255, 0.35);
    color: #fff;
    font: inherit;
    font-size: 0.9rem;
    letter-spacing: 0.15em;
    padding: 0.5rem 1.1rem;
    border-radius: 999px;
    cursor: pointer;
  }
  .skip:hover {
    background: rgba(255, 255, 255, 0.2);
  }
  .subs {
    position: absolute;
    left: 50%;
    bottom: 3rem;
    transform: translateX(-50%);
    width: min(90%, 46rem);
    text-align: center;
    font-size: clamp(1rem, 2.5vw, 1.25rem);
    color: #fff;
    text-shadow: 0 1px 6px rgba(0, 0, 0, 0.9);
    min-height: 1.4em;
  }
  .ghost-menu {
    appearance: none;
    background: transparent;
    border: 1px solid var(--me-edge);
    color: #dfe3e7;
    font: inherit;
    font-size: 0.9rem;
    padding: 0.5rem 1.1rem;
    border-radius: 2px;
    cursor: pointer;
    transition: border-color 0.15s ease;
  }
  .ghost-menu:hover {
    border-color: var(--me-red);
  }

  /* · Botón de retorno en modo clásico */
  .wt-restore {
    position: fixed;
    left: 1rem;
    bottom: 1rem;
    z-index: 61;
    appearance: none;
    background: #12161b;
    border: 1px solid #3a4148;
    color: #dfe3e7;
    font: inherit;
    font-size: 0.9rem;
    padding: 0.6rem 1.1rem;
    border-radius: 2px;
    cursor: pointer;
    box-shadow: 0 2px 12px rgba(0, 0, 0, 0.4);
    transition: border-color 0.15s ease;
  }
  .wt-restore:hover {
    border-color: #dd2c24;
  }
  .wt-restore:focus-visible {
    outline: 2px solid #ff5a4d;
    outline-offset: 3px;
  }
  .wt-restore[hidden] {
    display: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .wt::after,
    .status::before {
      animation: none;
    }
    .start,
    .seg-btn,
    .sound-toggle,
    .start-arrow,
    .classic-link svg,
    .ghost-menu,
    .wt-restore {
      transition: none;
    }
  }
</style>

<script>
  import { StateMachine } from '../walkthrough/state';
  import { AudioManager } from '../walkthrough/audio';
  import { STRINGS } from '../walkthrough/strings';
  import { UI, LANGS, localizePath, type Lang } from '../lib/i18n';

  const root = document.getElementById('wt');
  const restoreBtn = document.getElementById('wt-restore');

  if (root && restoreBtn) {
    const sm = new StateMachine();
    const screens = Array.from(
      root.querySelectorAll<HTMLElement>('[data-screen]'),
    );

    const read = (key: string): string | null => {
      try {
        return localStorage.getItem(key);
      } catch {
        return null;
      }
    };
    const write = (key: string, value: string): void => {
      try {
        localStorage.setItem(key, value);
      } catch {
        /* preferences are optional */
      }
    };

    const routeLang = (root.dataset.lang ?? 'es') as Lang;
    const storedLang = read('wt:lang');
    let lang: Lang =
      storedLang && (LANGS as readonly string[]).includes(storedLang)
        ? (storedLang as Lang)
        : routeLang;
    let muted = read('wt:muted') === '1';

    const audio = new AudioManager(lang, muted);

    const $ = <T extends HTMLElement = HTMLElement>(id: string): T => {
      const el = document.getElementById(id);
      if (!el) throw new Error(`[walkthrough] missing #${id}`);
      return el as T;
    };
    const startBtn = $<HTMLButtonElement>('wt-start');
    const loadingEl = $('wt-loading');
    const soundBtn = $<HTMLButtonElement>('wt-sound');
    const soundLabel = $('wt-sound-label');
    const classicLink = $<HTMLAnchorElement>('wt-classic');
    const skipBtn = $<HTMLButtonElement>('wt-skip');

    let voiceReady = false;

    /* · Render de estado · */
    const render = (state: string): void => {
      root!.dataset.state = state;
      restoreBtn.hidden = state !== 'classic';
      // Lock the page behind the overlay so the scrollbar can't show up
      // doing nothing; classic mode is the only state where we scroll.
      document.documentElement.style.overflow =
        state === 'classic' ? '' : 'hidden';
      if (state === 'menu') {
        // Re-enabling START whenever we come back to the menu; the voice
        // track is already cached after the first preload.
        startBtn.disabled = !voiceReady;
        if (voiceReady) loadingEl.setAttribute('data-done', '');
      }
      for (const screen of screens) {
        const active = screen.dataset.screen === state;
        screen.hidden = !active;
        if (active) screen.removeAttribute('inert');
        else screen.setAttribute('inert', '');
      }
    };
    sm.on(render);
    render(sm.state);

    /* · i18n en caliente · */
    const applyLang = (next: Lang): void => {
      lang = next;
      root!.dataset.lang = next;
      document.documentElement.lang = next;
      document.title = UI[next].siteTitle;
      write('wt:lang', next);

      for (const el of root!.querySelectorAll<HTMLElement>('[data-i18n]')) {
        const key = el.dataset.i18n as keyof (typeof STRINGS)['es'];
        el.textContent = STRINGS[next][key];
      }
      for (const el of root!.querySelectorAll<HTMLElement>('[data-i18n-aria]')) {
        const key = el.dataset.i18nAria as keyof (typeof STRINGS)['es'];
        el.setAttribute('aria-label', STRINGS[next][key]);
      }
      for (const btn of root!.querySelectorAll<HTMLButtonElement>('[data-lang-opt]')) {
        btn.setAttribute('aria-pressed', String(btn.dataset.langOpt === next));
      }
      updateSoundLabel();
      audio.setLang(next);

      const target = localizePath(location.pathname, next);
      if (location.pathname !== target) {
        history.replaceState(null, '', target);
      }
    };

    const updateSoundLabel = (): void => {
      soundLabel.textContent = muted
        ? STRINGS[lang].soundOff
        : STRINGS[lang].soundOn;
      soundBtn.setAttribute('aria-pressed', String(!muted));
    };

    /* · Preparación del audio (nunca deja el START bloqueado) · */
    let readyPromise: Promise<boolean> | null = null;
    const ensureVoice = (): Promise<boolean> => {
      readyPromise ??= audio.preload().then((ready) => {
        // Never leave START blocked: preload resolves or times out, and we
        // enable the button either way (degradation rule: no dead screens).
        voiceReady = true;
        if (sm.state === 'menu') {
          startBtn.disabled = false;
          loadingEl.setAttribute('data-done', '');
        }
        if (!ready) console.warn('[walkthrough] voice not fully buffered');
        return ready;
      });
      return readyPromise;
    };

    /* · Eventos del menú · */
    for (const btn of root!.querySelectorAll<HTMLButtonElement>('[data-lang-opt]')) {
      btn.addEventListener('click', () => {
        audio.blip(760);
        applyLang(btn.dataset.langOpt as Lang);
      });
    }

    soundBtn.addEventListener('click', () => {
      muted = !muted;
      write('wt:muted', muted ? '1' : '0');
      audio.setMuted(muted);
      updateSoundLabel();
      if (!muted) audio.blip(520);
    });

    startBtn.addEventListener('click', () => {
      audio.blip(980);
      startBtn.disabled = true;
      loadingEl.removeAttribute('data-done');
      loadingEl.textContent = STRINGS[lang].loading;
      void ensureVoice().then(() => {
        if (sm.set('cutscene')) {
          audio.play();
        } else {
          startBtn.disabled = false;
        }
        loadingEl.setAttribute('data-done', '');
      });
    });

    audio.onEnded = () => {
      if (sm.state === 'cutscene') sm.set('fp');
    };

    skipBtn.addEventListener('click', () => {
      audio.blip(640);
      audio.stop();
      sm.set('fp');
    });

    classicLink.addEventListener('click', (event) => {
      event.preventDefault();
      audio.blip(560);
      if (sm.set('classic')) {
        document
          .getElementById('work')
          ?.scrollIntoView({ behavior: 'smooth', block: 'start' });
      }
    });

    restoreBtn.addEventListener('click', () => {
      audio.blip(700);
      sm.set('menu');
      window.scrollTo({ top: 0, behavior: 'smooth' });
    });

    for (const btn of root!.querySelectorAll<HTMLButtonElement>('[data-goto-menu]')) {
      btn.addEventListener('click', () => {
        audio.stop();
        sm.set('menu');
      });
    }

    /* · Init · */
    applyLang(lang);
    audio.setMuted(muted);
    void ensureVoice();
  }
</script>
