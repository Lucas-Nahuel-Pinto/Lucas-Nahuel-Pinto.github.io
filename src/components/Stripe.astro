---
import type { Lang, Stripe as StripeData } from '../lib/projects';
import MetricCallout from './MetricCallout.astro';

interface Props {
  index: number;
  title: string;
  pitch: string;
  slug: string;
  stripe: StripeData;
  lang: Lang;
  repoUrl?: string;
  viewCode: string;
  openCase: string;
}

const { index, title, pitch, slug, stripe, lang, repoUrl, viewCode, openCase } = Astro.props;
const flip = index % 2 === 1;
const caseHref = `/${lang}/proyectos/${slug}/`;
const labels =
  lang === 'es'
    ? { problem: 'Problema', solution: 'Solución', result: 'Resultado' }
    : { problem: 'Problem', solution: 'Solution', result: 'Result' };
---

<article class:list={['stripe', flip && 'flip']} id={slug}>
  <div class="stripe-inner">
    <div class="stripe-text">
      <p class="stripe-kicker">{String(index + 1).padStart(2, '0')}</p>
      <h3>{title}</h3>
      <p class="stripe-pitch">{pitch}</p>
      <dl>
        <div>
          <dt>{labels.problem}</dt>
          <dd>{stripe.problem}</dd>
        </div>
        <div>
          <dt>{labels.solution}</dt>
          <dd>{stripe.solution}</dd>
        </div>
        <div>
          <dt>{labels.result}</dt>
          <dd>{stripe.result}</dd>
        </div>
      </dl>
      <div class="stripe-actions">
        <a class="btn btn-primary" href={caseHref}>{openCase}</a>
        {repoUrl && (
          <a class="btn btn-ghost" href={repoUrl} target="_blank" rel="noopener">
            {viewCode}
          </a>
        )}
      </div>
    </div>
    <div class="stripe-metric">
      <MetricCallout metric={stripe.metric} align="center" />
    </div>
  </div>
</article>

<style>
  .stripe {
    border-top: 1px solid var(--border);
    background: var(--bg);
  }
  .stripe.flip {
    background: var(--bg-subtle);
  }
  .stripe-inner {
    max-width: 1100px;
    margin: 0 auto;
    padding: 3rem 1.25rem;
    display: grid;
    grid-template-columns: 1fr 240px;
    gap: 2.5rem;
    align-items: start;
  }
  .flip .stripe-inner {
    grid-template-columns: 240px 1fr;
  }
  .flip .stripe-text {
    order: 2;
  }
  .flip .stripe-metric {
    order: 1;
  }
  .stripe-kicker {
    font-weight: 800;
    color: var(--accent);
    letter-spacing: 0.1em;
    margin: 0 0 0.35rem;
    font-size: 0.8rem;
  }
  .stripe h3 {
    margin: 0 0 0.5rem;
    font-size: 1.5rem;
  }
  .stripe-pitch {
    color: var(--fg-muted);
    margin: 0 0 1.25rem;
    max-width: 60ch;
  }
  dl {
    margin: 0;
    display: grid;
    gap: 0.85rem;
  }
  dt {
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--accent);
  }
  dd {
    margin: 0.15rem 0 0;
    color: var(--fg);
    max-width: 65ch;
  }
  .stripe-actions {
    display: flex;
    gap: 0.75rem;
    margin-top: 1.5rem;
    flex-wrap: wrap;
  }
  @media (max-width: 800px) {
    .stripe-inner,
    .flip .stripe-inner {
      grid-template-columns: 1fr;
    }
    .flip .stripe-text,
    .flip .stripe-metric {
      order: initial;
    }
  }
</style>
