---
import { existsSync } from 'node:fs';
import { join } from 'node:path';
import { UI, type Lang } from '../lib/i18n';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = UI[lang];
const year = new Date().getFullYear();
const hasCv = existsSync(join(process.cwd(), 'public', 'cv', 'lucas-pinto-cv.pdf'));
const hasEmail = t.contactEmail !== undefined && !t.contactEmail.includes('example.com');
---

<footer class="footer">
  <div class="container footer-inner">
    <span class="muted">© {year} Lucas Nahuel Pinto · {t.footerNote}</span>
    <span class="links">
      {hasEmail && <a href={`mailto:${t.contactEmail}`}>Email</a>}
      <a href="https://github.com/Lucas-Nahuel-Pinto" target="_blank" rel="noopener">GitHub</a>
      {hasCv && <a href="/cv/lucas-pinto-cv.pdf" download>CV</a>}
    </span>
  </div>
</footer>

<style>
  .footer {
    border-top: 1px solid var(--border);
    margin-top: 3rem;
    padding: 1.25rem 0;
    font-size: 0.85rem;
  }
  .footer-inner {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
  }
  .links a {
    margin-left: 1rem;
  }
</style>
