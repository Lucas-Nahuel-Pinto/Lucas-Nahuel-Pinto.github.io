---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Stripe from '../../components/Stripe.astro';
import Walkthrough from '../../components/Walkthrough.astro';
import { LANGS } from '../../lib/i18n';
import { PROJECTS } from '../../lib/projects';

export function getStaticPaths() {
  return LANGS.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as 'es' | 'en';

const copy = {
  es: {
    heroRole: 'QA Engineer',
    heroPitch:
      'Diseño flujos de QA que evitan bugs en vez de cazarlos: trazabilidad completa, checklists navegables y automatización con agentes.',
    scroll: 'Ver proyectos ↓',
    workTitle: 'Proyectos',
    workIntro: 'Tres proyectos con evidencia ejecutable: checklists en vivo, dashboard de trazabilidad con datos sintéticos y un panel para gestionar arnés de agentes.',
    viewCode: 'Ver código',
    openCase: 'Abrir caso de estudio',
  },
  en: {
    heroRole: 'QA Engineer',
    heroPitch:
      'I design QA flows that prevent bugs instead of hunting them: full traceability, navigable checklists and agent-driven automation.',
    scroll: 'See projects ↓',
    workTitle: 'Projects',
    workIntro: 'Three projects with runnable evidence: live checklists, a traceability dashboard with synthetic data and a panel to manage any agent harness.',
    viewCode: 'View code',
    openCase: 'Open case study',
  },
}[lang];
---

<BaseLayout lang={lang} path="">
  <noscript>
    <style>
      #wt,
      .wt-restore {
        display: none !important;
      }
    </style>
  </noscript>

  <Walkthrough lang={lang} />

  <section class="hero">
    <p class="role">{copy.heroRole}</p>
    <h1>Lucas Pinto</h1>
    <p class="pitch">{copy.heroPitch}</p>
    <a class="btn btn-primary" href="#work">{copy.scroll}</a>
  </section>

  <section id="work" class="work-head">
    <h2>{copy.workTitle}</h2>
    <p class="muted">{copy.workIntro}</p>
  </section>

  {PROJECTS.map((project, index) => {
    const data = project.content[lang];
    return (
      <Stripe
        index={index}
        title={data.caseStudy.title}
        pitch={data.caseStudy.pitch}
        slug={project.slug}
        stripe={data.stripe}
        lang={lang}
        repoUrl={project.repo?.url}
        viewCode={copy.viewCode}
        openCase={copy.openCase}
      />
    );
  })}
</BaseLayout>

<style>
  .hero {
    padding: 4.5rem 0 3rem;
    text-align: center;
  }
  .role {
    color: var(--accent);
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    font-size: 0.85rem;
    margin: 0 0 0.5rem;
  }
  .hero h1 {
    font-size: clamp(2.2rem, 6vw, 3.4rem);
    margin: 0 0 0.75rem;
  }
  .pitch {
    max-width: 640px;
    margin: 0 auto 1.5rem;
    color: var(--fg-muted);
    font-size: 1.1rem;
  }
  .work-head {
    padding: 2rem 1.25rem 1.5rem;
    max-width: 1100px;
    margin: 0 auto;
  }
  .work-head h2 {
    margin: 0 0 0.5rem;
  }
  .work-head .muted {
    color: var(--fg-muted);
    margin: 0;
    max-width: 70ch;
  }
</style>
