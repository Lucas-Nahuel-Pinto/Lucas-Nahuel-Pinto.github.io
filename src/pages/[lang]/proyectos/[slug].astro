---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import CaseStudy from '../../../components/CaseStudy.astro';
import { LANGS } from '../../../lib/i18n';
import { getProject, PROJECTS } from '../../../lib/projects';

export const SLUGS = PROJECTS.map((p) => p.slug);

export function getStaticPaths() {
  return LANGS.flatMap((lang) => SLUGS.map((slug) => ({ params: { lang, slug } })));
}

const lang = Astro.params.lang as 'es' | 'en';
const slug = Astro.params.slug!;
const project = getProject(slug)!;
const copy = project.content[lang].caseStudy;
---

<BaseLayout lang={lang} title={copy.title} path={`/proyectos/${slug}`} description={copy.pitch}>
  <CaseStudy
    lang={lang}
    copy={copy}
    repoUrl={project.repo?.url}
    repoLabel={project.repo?.label}
  />
</BaseLayout>
